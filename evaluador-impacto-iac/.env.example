# Copia este archivo como .env para desarrollo local.
# No suba .env al repositorio.

# Claves de IA: SOLO en el servidor (proxy Vite / funciones Vercel).
# No use el prefijo VITE_: Vite lo copia al JavaScript del navegador.
MISTRAL_API_KEY=tu_api_key_aqui
ANTHROPIC_API_KEY=tu_api_key_aqui

# Supabase — el navegador solo recibe la URL y la clave anon (pública).
# La anon key no autoriza por sí sola: las filas exigen sesión (migración 002).
# NUNCA ponga aquí la service role, ni con prefijo VITE_.
# Solo la URL del proyecto, SIN /rest/v1 al final:
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Quién puede entrar (correo y contraseña, y Google).
# Lista vacía = nadie. Deben coincidir con las filas de la migración 003.
# Varios valores separados por coma. El dominio autoriza a todo ese dominio.
ALLOWED_EMAILS=admin@empresa.com
ALLOWED_EMAIL_DOMAINS=
